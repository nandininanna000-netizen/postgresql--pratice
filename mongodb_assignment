// PART 3 - AGGREGATION BASICS
// ==================================
// 3.1 Total students and average age
db.students.aggregate([
{
$group:{
_id:null,
totalStudents:{$sum:1},
averageAge:{$avg:"$age"}
}
}
]);
// 3.2 Highest and lowest marks
db.students.aggregate([
{
$group:{
_id:null,
highestMarks:{$max:"$marks"},
lowestMarks:{$min:"$marks"}
}
}
]);
// 3.3 Count all students
db.students.countDocuments({});
// Count students having non-null marks
db.students.countDocuments({
marks:{$ne:null}
});
// Difference: Sara has null marks.
// 3.4 Count students in each grade
db.students.aggregate([
{
$group:{
_id:"$grade",
total:{$sum:1}
}
},
{$sort:{_id:1}}
]);
// 3.5 Average marks in each city
db.students.aggregate([
{
$group:{
_id:"$city",
averageMarks:{$avg:"$marks"}
}
},
{
$project:{
averageMarks:{$round:["$averageMarks",1]}
}
},
{$sort:{averageMarks:-1}}
]);
// 3.6 Cities having average marks above 75
db.students.aggregate([
{
$group:{
_id:"$city",
averageMarks:{$avg:"$marks"}
}
},
{
$match:{
averageMarks:{$gt:75}
}
}
]);
// 3.7 Grades having at least 2 students
db.students.aggregate([
{
$group:{
_id:"$grade",
total:{$sum:1}
}
},
{
$match:{
total:{$gte:2}
}
}
]);
// 3.8 Count students in each course
db.enrollments.aggregate([
{
$group:{
_id:"$course_id",
totalStudents:{$sum:1}
}
}
]);
// Course 5 is missing because nobody enrolled in Robotics.
// 3.9 Highest score in each course
db.enrollments.aggregate([
{
$group:{
_id:"$course_id",
highestScore:{$max:"$score"}
}
}
]);
// 3.10 Count students and students with marks in each city
db.students.aggregate([
{
$group:{
_id:"$city",
totalStudents:{$sum:1},
studentsWithMarks:{
$sum:{
$cond:[
{$ne:["$marks",null]},
1,
0
]
}
}
}
}
]);

