//PART 1 - READ AND FILTER 
// 1.1 Show all students
  db.students.find({});
// 1.2 Show name and city of students older than 10
 db.students.find( {age:{$gt:10}}, {_id:0, name:1, city:1} );
// 1.3 Students in grade 5 or 7 using OR
 db.students.find({ $or:[{grade:5},{grade:7}] }).sort({name:1});
// 1.3 Students in grade 5 or 7 using IN 
 db.students.find({ grade:{$in:[5,7]} }).sort({name:1});
// 1.4 Names starting with A
 db.students.find({ name:/^A/ });
// 1.5 Find students with null marks
 db.students.find({ marks:null });
//1.6 Find students where marks field is completely missing 
db.students.find({ marks:{$exists:false} });
// 1.7 Show top 3 students with marks 
db.students.find({ marks:{$ne:null} }).sort({marks:-1}).limit(3);
// 1.8 Show different cities 
db.students.distinct("city");
// 1.9 Students who know both math and science
 db.students.find({ skills:{$all:["math","science"]} });
// 1.10 Students having exactly 2 skills
 db.students.find({ skills:{$size:2} });
// 1.11 (a) Insert Priya
db.students.insertOne({ name:"Priya", age:11, grade:6, city:"Pune", marks:81, skills:["art"] });
//part 2 - UPDATE AND DELETE
// 2.1Add email to Kabir
db.students.updateOne(
{name:"Kabir"},
{$set:{email:"kabir@example.com"}}
);
// Show Kabir after update
db.students.find({name:"Kabir"});
// 2.2 Rename email to email_id
db.students.updateOne(
{name:"Kabir"},
{$rename:{email:"email_id"}}
);
// 2.3 Remove email_id
db.students.updateOne(
{name:"Kabir"},
{$unset:{email_id:""}}
);
// Check Kabir
db.students.find({name:"Kabir"});
// 2.4 Add 3 marks to grade 5 students
db.students.updateMany(
{grade:5},
{$inc:{marks:3}}
);
// 2.5 Add coding skill to Mumbai students
db.students.updateMany(
{city:"Mumbai"},
{$addToSet:{skills:"coding"}}
);
// 2.6 Create Ishaan using upsert
db.students.updateOne(
{name:"Ishaan"},
{$set:{city:"Delhi", grade:7, marks:60}},
{upsert:true}
);
// Check Ishaan
db.students.find({name:"Ishaan"});
// 2.7 Delete Ishaan
db.students.deleteOne({name:"Ishaan"});
// Delete students having marks below 58
db.students.deleteMany({
marks:{$lt:58}
});
